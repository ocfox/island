+// What the compositor told us about an output's color encoding, via
+// wp_color_manager_v1. All luminances are in cd/m².
+struct grim_color_info {
+	bool has_tf;
+	uint32_t tf_named; // enum wp_color_manager_v1_transfer_function
+	bool has_primaries;
+	uint32_t primaries_named; // enum wp_color_manager_v1_primaries
+	bool has_luminances;
+	double min_lum, max_lum, reference_lum;
+};

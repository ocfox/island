diff --git a/tonemap.c b/tonemap.c
new file mode 100644
index 0000000..f1ffc2e
--- /dev/null
+++ b/tonemap.c
@@ -0,0 +1,139 @@
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "render.h"
+#include "tonemap.h"
+
+#include "color-management-v1-protocol.h"
+
+// SMPTE ST 2084 constants
+#define PQ_M1 (2610.0 / 16384.0)
+#define PQ_M2 (2523.0 / 4096.0 * 128.0)
+#define PQ_C1 (3424.0 / 4096.0)
+#define PQ_C2 (2413.0 / 4096.0 * 32.0)
+#define PQ_C3 (2392.0 / 4096.0 * 32.0)
+
+// Inverse of the PQ OETF: a signal value in [0, 1] to absolute luminance in
+// cd/m², where 1.0 corresponds to 10000 cd/m².
+static double pq_to_luminance(double e) {
+	double ep = pow(e, 1.0 / PQ_M2);
+	double num = ep - PQ_C1;
+	if (num < 0.0) {
+		num = 0.0;
+	}
+	return 10000.0 * pow(num / (PQ_C2 - PQ_C3 * ep), 1.0 / PQ_M1);
+}
+
+// Compositors encode SDR output with a pure 2.2 power curve rather than the
+// piecewise sRGB one, so using it here is what makes a capture of an HDR output
+// match a capture of the same content with HDR turned off.
+#define SDR_GAMMA 2.2
+
+static double sdr_encode(double v) {
+	return pow(v, 1.0 / SDR_GAMMA);
+}
+
+// BT.2020 to BT.709 primaries, in linear light
+static const double bt2020_to_srgb[3][3] = {
+	{  1.6605, -0.5876, -0.0728 },
+	{ -0.1246,  1.1329, -0.0083 },
+	{ -0.0182, -0.1006,  1.1187 },
+};
+
+bool color_needs_tonemap(const struct grim_color_info *color) {
+	return color->has_tf &&
+		color->tf_named == WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ;
+}
+
+#define ENCODE_LUT_SIZE 4096
+
+pixman_image_t *tonemap_to_sdr(pixman_image_t *image,
+		const struct grim_color_info *color) {
+	pixman_format_code_t format = pixman_image_get_format(image);
+	if (!is_format_10bpc(format)) {
+		fprintf(stderr, "cannot tone map a %d bit per pixel capture\n",
+			PIXMAN_FORMAT_BPP(format));
+		return NULL;
+	}
+
+	int width = pixman_image_get_width(image);
+	int height = pixman_image_get_height(image);
+	int stride = pixman_image_get_stride(image);
+	uint32_t *data = pixman_image_get_data(image);
+
+	// Diffuse white sits at the reference luminance, so scaling by it puts
+	// ordinary SDR content at 1.0. Anything brighter is a highlight that
+	// cannot be represented in sRGB and gets clipped below.
+	double reference_lum = color->has_luminances ? color->reference_lum : 203.0;
+	if (reference_lum <= 0.0) {
+		reference_lum = 203.0;
+	}
+
+	// The source is 10-bit, so the electro-optical transfer function is
+	// exactly representable as a table
+	double decode[1024];
+	for (int i = 0; i < 1024; i++) {
+		decode[i] = pq_to_luminance(i / 1023.0) / reference_lum;
+	}
+
+	// The encode step only feeds an 8-bit result, so a table indexed by the
+	// clipped linear value is accurate enough and avoids a pow() per channel
+	uint8_t encode[ENCODE_LUT_SIZE];
+	for (int i = 0; i < ENCODE_LUT_SIZE; i++) {
+		double v = sdr_encode(i / (double)(ENCODE_LUT_SIZE - 1));
+		encode[i] = (uint8_t)lround(v * 255.0);
+	}
+
+	bool convert_primaries = !color->has_primaries ||
+		color->primaries_named != WP_COLOR_MANAGER_V1_PRIMARIES_SRGB;
+
+	pixman_image_t *dst = pixman_image_create_bits(PIXMAN_a8r8g8b8,
+		width, height, NULL, 0);
+	if (!dst) {
+		fprintf(stderr, "failed to create image with size: %d x %d\n",
+			width, height);
+		return NULL;
+	}
+	int dst_stride = pixman_image_get_stride(dst);
+	uint32_t *dst_data = pixman_image_get_data(dst);
+
+	for (int y = 0; y < height; y++) {
+		const uint32_t *src_row = (const uint32_t *)((uint8_t *)data + y * stride);
+		uint32_t *dst_row = (uint32_t *)((uint8_t *)dst_data + y * dst_stride);
+
+		for (int x = 0; x < width; x++) {
+			uint32_t px = src_row[x];
+			double rgb[3] = {
+				decode[(px >> 20) & 0x3ff],
+				decode[(px >> 10) & 0x3ff],
+				decode[(px >>  0) & 0x3ff],
+			};
+
+			if (convert_primaries) {
+				double in[3] = { rgb[0], rgb[1], rgb[2] };
+				for (int c = 0; c < 3; c++) {
+					rgb[c] = bt2020_to_srgb[c][0] * in[0] +
+						bt2020_to_srgb[c][1] * in[1] +
+						bt2020_to_srgb[c][2] * in[2];
+				}
+			}
+
+			uint32_t out = 0xff000000;
+			for (int c = 0; c < 3; c++) {
+				double v = rgb[c];
+				if (v < 0.0) {
+					v = 0.0;
+				} else if (v > 1.0) {
+					v = 1.0;
+				}
+				int idx = (int)lround(v * (ENCODE_LUT_SIZE - 1));
+				out |= (uint32_t)encode[idx] << (16 - 8 * c);
+			}
+			dst_row[x] = out;
+		}
+	}
+
+	pixman_image_unref(image);
+	return dst;
+}
-- 
